<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booknook_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/bookTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/booknook_black"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="달러구트 꿈 백화점 오늘의 기록" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/quick_record_progress_label"
            android:textColor="@color/booknook_black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/progressSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progressTint="@color/booknook_accent"
            android:thumbTint="@color/booknook_accent" />

        <TextView
            android:id="@+id/progressValueText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/booknook_accent"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="42%" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/quick_record_pages_label"
            android:textColor="@color/booknook_black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/pagesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/quick_record_pages_hint"
            android:inputType="number"
            android:maxLines="1"
            android:textColor="@color/booknook_black"
            android:textColorHint="@color/booknook_gray"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:backgroundTint="@color/booknook_accent"
            android:text="@string/quick_record_save_button"
            android:textColor="@color/booknook_white"
            android:textSize="16sp"
            app:cornerRadius="8dp" />

    </LinearLayout>

</ScrollView>
